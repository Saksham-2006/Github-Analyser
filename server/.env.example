# GitHub Personal Access Token
GITHUB_TOKEN=your_github_personal_access_token_here

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/github-analyzer

# Netlify frontend URL (used for CORS) — no trailing slash
CLIENT_URL=https://your-app.netlify.app

# Backend Server Port (Render sets this automatically)
PORT=5000
